    <!-- DISCOUNT EYE -->
    <div class="discount-fab" id="discountFab" onclick="openDiscount()" title="A little secret for you">
        <svg viewBox="0 0 200 120"><g><path d="M 20 60 Q 100 8 180 60 Q 100 112 20 60 Z" fill="#000" stroke="#012" stroke-width="7"/><circle cx="100" cy="60" r="26" fill="#012"/><circle cx="100" cy="60" r="10.5" fill="#26c6da"/><circle cx="107" cy="53" r="5" fill="#fff"/></g></svg>
        <span>Get &minus;10 %</span>
    </div>
    <div class="discount-overlay" id="discountOverlay">
        <div class="discount-box">
            <span class="disc-close" onclick="closeDiscount()">&times;</span>
            <svg class="disc-eye" viewBox="0 0 200 120"><g class="disc-eye-g"><path d="M 20 60 Q 100 8 180 60 Q 100 112 20 60 Z" fill="#020202" stroke="#26c6da" stroke-width="3.5"/><circle cx="100" cy="60" r="26" fill="#26c6da"/><circle cx="100" cy="60" r="10.5" fill="#000"/><circle cx="107" cy="53" r="5" fill="#fff"/></g></svg>
            <div class="disc-title">Psst&hellip; open your eyes.</div>
            <div class="disc-sub">Here is <b style="color:#fff;">10&nbsp;% off</b> your first order:</div>
            <div class="disc-code" id="discCode" onclick="copyDiscount()">OPENEYES10</div>
            <div class="disc-copied" id="discCopied">Copied &#10003;</div>
            <div class="disc-note">Tap the code to copy it, then use it at checkout.</div>
        </div>
    </div>

    <!-- CART DRAWER -->
    <div class="cart-overlay" id="cartOverlay" onclick="toggleCart(false)"></div>
    <aside class="cart-drawer" id="cartDrawer">
        <div class="cart-head">
            <h3>Your Cart</h3>
            <span class="cart-close" onclick="toggleCart(false)">&times;</span>
        </div>
        <div class="cart-items" id="cartItems"></div>
        <div class="cart-foot">
            <div class="cart-total-row"><span>Total</span><span id="cartTotal">€0.00</span></div>
            <button class="btn" onclick="checkout()">Checkout</button>
            <div class="secure-note">&#128274; Secure checkout &middot; powered by Shopify</div>
            <div class="pay-badges"><span>Visa</span><span>Mastercard</span><span>Maestro</span><span>Apple&nbsp;Pay</span><span>Google&nbsp;Pay</span><span>PayPal</span></div>
            <div class="cart-note" id="cartNote">You'll finish payment on our secure Shopify checkout at mareswear.com.</div>
        </div>
    </aside>
    <!-- ADD-TO-CART EYE ANIMATION -->
    <div class="blink-overlay" id="blinkOverlay">
        <div class="blink-eye-wrap">
            <svg class="blink-eye" viewBox="0 0 200 120">
                <g class="big-eye">
                    <path d="M 20 60 Q 100 8 180 60 Q 100 112 20 60 Z" fill="#020202" stroke="#26c6da" stroke-width="3.5"/>
                    <circle cx="100" cy="60" r="26" fill="#26c6da"/>
                    <circle cx="100" cy="60" r="10.5" fill="#000"/>
                    <circle cx="107" cy="53" r="5" fill="#fff"/>
                </g>
            </svg>
            <svg class="blink-tear-big" viewBox="0 0 24 32"><path d="M12 30 C 7.5 30 4 26.4 4 22 C 4 16.5 10 6.5 12 2 C 14 6.5 20 16.5 20 22 C 20 26.4 16.5 30 12 30 Z"/></svg>
        </div>
        <svg class="mares-write" viewBox="0 0 420 150">
            <defs><clipPath id="writeClip"><rect class="write-reveal" x="0" y="0" width="0" height="150"/></clipPath></defs>
            <text x="210" y="105" text-anchor="middle" font-family="'Caveat', cursive" font-weight="700" font-size="104" class="write-text" clip-path="url(#writeClip)">Mares</text>
        </svg>
    </div>

    <div class="toast" id="toast">Added to cart ✓</div>

    <!-- MODAL OVERLAY -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal()">&times;</span>
            <!-- Image side -->
            <div class="modal-image" id="modalImage">
                <!-- SVG injected via JS -->
            </div>
            <!-- Info side -->
            <div class="modal-info">
                <h2 id="modalTitle">Product Title</h2>
                <div class="price" id="modalPrice">€0.00</div>
                <p id="modalDesc">Product description goes here.</p>
                <div style="background: rgba(38, 198, 218, 0.1); border-left: 3px solid var(--accent-cyan); padding: 15px; margin-bottom: 2rem;">
                    <p style="margin:0; font-size: 0.85rem; color: #fff;">🌍 <strong>Protectors of the Earth</strong><br>By purchasing this, <strong>5%</strong> is donated to environmental projects. Produced strictly on demand = <strong>Zero Waste</strong>.</p>
                </div>
                <div class="size-label">Size</div>
                <div class="size-row" id="sizeRow">
                    <div class="size-pill" onclick="selSize(this)">S</div>
                    <div class="size-pill sel" onclick="selSize(this)">M</div>
                    <div class="size-pill" onclick="selSize(this)">L</div>
                    <div class="size-pill" onclick="selSize(this)">XL</div>
                </div>
                <button class="btn" id="modalBuyNow" onclick="buyNowFromModal()">Buy Now</button>
                <button class="btn btn-outline" id="modalBuyBtn" onclick="addToCartFromModal()" style="margin-top:10px;">Add to Cart</button>
            </div>
        </div>
    </div>

<script src="{{ 'mares.js' | asset_url }}"></script>

{% schema %}
{
  "name": "MARES Home",
  "settings": []
}
{% endschema %}
